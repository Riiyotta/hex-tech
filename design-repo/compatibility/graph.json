{
  "$description": "Rhythm/position rules. Each id is implemented in schema/semantic_validate.py; verify_all.py fails if the two sets drift.",
  "rules": [
    {
      "id": "SCHEMA_VALID",
      "severity": "error",
      "description": "The PageSpec validates against schema/pagespec.schema.json (Draft-07).",
      "measuredFrom": []
    },
    {
      "id": "TEMPLATE_KNOWN",
      "severity": "error",
      "description": "template must be one of templates/templates.json.",
      "measuredFrom": []
    },
    {
      "id": "TEMPLATE_SEQUENCE",
      "severity": "error",
      "description": "nodes[] must match the declared template's own node list (order, required, repeatable, variants, slot bounds).",
      "measuredFrom": [
        "CLONE_SPEC.md:43"
      ]
    },
    {
      "id": "ROUTE_FORMAT",
      "severity": "error",
      "description": "route is a lowercase path with leading and trailing slash (live URL form).",
      "measuredFrom": [
        "CLONE_SPEC.md:256"
      ]
    },
    {
      "id": "ROUTE_TEMPLATE_CONSISTENCY",
      "severity": "error",
      "description": "An existing route must use the template routes.json maps it to.",
      "measuredFrom": []
    },
    {
      "id": "HOME_ROUTE_ONLY",
      "severity": "error",
      "description": "template.home and homeRouteOnly sections only on '/'.",
      "measuredFrom": [
        "CLONE_SPEC.md:1"
      ]
    },
    {
      "id": "THEME_ALLOWED",
      "severity": "error",
      "description": "theme must be one the template is observed in (light/dark per route).",
      "measuredFrom": [
        "src/routes.jsx:3"
      ]
    },
    {
      "id": "LAYOUT_MATCH",
      "severity": "error",
      "description": "layout ('site'|'standalone') must equal the template's layout.",
      "measuredFrom": [
        "src/routes.jsx:4"
      ]
    },
    {
      "id": "PLACEHOLDER_TEMPLATE",
      "severity": "warn",
      "description": "template.placeholder is the 'page still being built' fallback; it validates but is not a generation target.",
      "measuredFrom": [
        "src/pages/PagePending.jsx:1"
      ]
    },
    {
      "id": "CHROME_POSITION",
      "severity": "error",
      "description": "site layout: shell.header first and shell.footer last, once each; standalone: no shell nodes.",
      "measuredFrom": [
        "specs/company.md:38"
      ]
    },
    {
      "id": "ONE_HERO",
      "severity": "error",
      "description": "Exactly one hero.* node per page.",
      "measuredFrom": [],
      "exceptions": [],
      "exceptionNote": "No template is hero-less: every template in templates.json has exactly one hero.* entry (checked by verify_all against templates.json, and by the per-template controls)."
    },
    {
      "id": "HERO_FIRST",
      "severity": "error",
      "description": "The hero is the first content node (right after shell.header, or first in standalone).",
      "measuredFrom": []
    },
    {
      "id": "ONE_PER_PAGE",
      "severity": "error",
      "description": "Sections declaring onePerPage / maxPerPage respect the limit.",
      "measuredFrom": []
    },
    {
      "id": "NO_ADJACENT_SAME_SECTION",
      "severity": "warn",
      "description": "The same (section, variant) should not repeat back-to-back, except sections that are observed repeating consecutively.",
      "measuredFrom": [],
      "exceptions": [
        "collection.integration-category",
        "content.guide-chapter",
        "content.report-section",
        "feature.cell-collage",
        "feature.solution-row",
        "feature.split",
        "feature.v1-two-up"
      ],
      "exceptionNote": "Sections with constraints.consecutiveAllowed (observed repeating back-to-back on real routes)."
    },
    {
      "id": "MOTION_PATTERN_ALLOWED",
      "severity": "error",
      "description": "node.motion.pattern is one of the section's allowedPatterns.",
      "measuredFrom": []
    },
    {
      "id": "REDUCED_MOTION_FALLBACK",
      "severity": "error",
      "description": "Every node declares reducedMotionFallback, locked to its pattern.",
      "measuredFrom": [
        "CLONE_SPEC.md:442"
      ]
    },
    {
      "id": "MOTION_BUDGET",
      "severity": "warn",
      "description": "Sections that carry continuous motion (marquee, perlin drift, rotators, typing) stay within the observed per-page maximum.",
      "measuredFrom": [],
      "max": 6,
      "maxDerivedFrom": "max over routes.json of nodes whose section allows a continuous motion pattern"
    },
    {
      "id": "MAX_WORDS",
      "severity": "error",
      "description": "Every text field respects its maxWords budget; rich-text blocks respect maxBlocks and maxWordsPerBlock.",
      "measuredFrom": []
    },
    {
      "id": "ASSET_ROLE_POLICY",
      "severity": "error",
      "description": "media.src obeys the asset role's generationPolicy (placeholder-only, must-reuse-exact, external-reference-only).",
      "measuredFrom": [
        "CLONE_SPEC.md:501"
      ]
    },
    {
      "id": "LINK_FORMAT",
      "severity": "error",
      "description": "Internal links are relative /paths ending in '/', #anchors or mailto:; external links are https:// plain hrefs; the external flag agrees.",
      "measuredFrom": [
        "src/layouts/SiteShell.jsx:2"
      ]
    },
    {
      "id": "INTERNAL_LINK_ROUTED",
      "severity": "warn",
      "description": "Internal hrefs should resolve to a known route; unknown paths render the placeholder.",
      "measuredFrom": [
        "src/routes.jsx:1"
      ]
    },
    {
      "id": "FORM_NO_SUBMISSION",
      "severity": "error",
      "description": "Forms are visual-only: conversion.form-shell.submission must be 'none'; no endpoint fields exist in the schema.",
      "measuredFrom": [
        "src/pages/pricingForms/forms/HubSpotFormShell.jsx:3"
      ]
    },
    {
      "id": "GENERATED_MODE_REFERENCE_ASSET",
      "severity": "error",
      "description": "In mode 'generated' no reference-only asset role (the real Hex wordmark/logo, the saved capture) and no src under /assets/ (the source's own files) may appear.",
      "measuredFrom": []
    },
    {
      "id": "GENERATED_MODE_SOURCE_BRAND",
      "severity": "error",
      "description": "In mode 'generated' no route, meta, text, alt, src or href may name the source brand or one of its mark files (assets/asset-roles.json sourceBrand.patterns plus the filename stems of the reference-only allowedSources).",
      "measuredFrom": []
    },
    {
      "id": "GENERATED_MODE_BRAND_REQUIRED",
      "severity": "error",
      "description": "In mode 'generated' shell.header and shell.footer must carry content.brand with a generation-safe role (brand.placeholder or brand.user-supplied); the chrome would otherwise render the real Hex wordmark.",
      "measuredFrom": []
    }
  ],
