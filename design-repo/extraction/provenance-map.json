    "PROOF",
    "SHELL"
  ],
  "retrievalIneligible": {
    "shell.header": "Global fixed chrome: an announcement ticker plus mega-menu navigation. It is runtime UI whose copy is global data a page never authors, so it adds noise as a retrieved exemplar.",
    "divider.tron": "Layout-only utility: a 61px stack of nine hairline rules with no authorable copy, so retrieving it as an exemplar adds noise.",
    "hero.placeholder": "Fallback stand-in for pages the clone has not built; it is not a page opening to imitate and the template is not a generation target."
  },
