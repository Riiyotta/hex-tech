"/* PortableText__StyledLink */ .jegdgA { color: var(--highlightColor, #F5C0C0); border-color: var(--highlightColor, #F5C0C0); }\n/* PortableText__StyledLink */ .jegdgA:hover { text-decoration: none; background-color: color-mix(in srgb, var(--highlightColor, #F5C0C0) 30%, transparent); }\n/* sharedStyles__Wrapper */ .dcoWOX { display: flex; align-items: stretch; max-width: 1240px; width: 100%; gap: 70px; z-index: 1; padding: 0px 40px; justify-content: center; margin: 0px auto; }\n/* sharedStyles__Wrapper */ @media (max-width: 800px) { .dcoWOX { flex-direction: column; padding: 0px 30px; gap: 40px; } }\n/* sharedStyles__LiveDemoWrapper */ .dHvKwz { width: 100vw; margin-left: calc(50% - 50vw); position: relative; margin-top: 10px; margin-bottom: 200px; padding: 0px 40px; box-sizing: border-box; }\n/* sharedStyles__LiveDemoWrapper */ @media (max-width: 800px) { .dHvKwz { margin-top: 10px; margin-bottom: 40px; padding: 0px 30px; } }\n/* sharedStyles__LiveDemoWrapper */ @media (max-width: 600px) { .dHvKwz { padding: 0px 20px; } }\n/* sharedStyles__CenteredFeatureInfo */ .bYRugQ { text-align: center; margin: 0px auto; }\n/* sharedStyles__CenteredFeatureInfo */ @media (max-width: 600px) { .bYRugQ { text-align: center; } }\n/* sharedStyles__CenteredFeatureInfo */ @media (max-width: 600px) { .bYRugQ h2, .bYRugQ h4 { text-align: center; } }\n/* SelfServeLiveDemo__Wrapper */ .kpeOUc { display: flex; flex-direction: column; align-items: center; width: 100%; }\n/* SelfServeLiveDemo__Wrapper */ @media (max-width: 600px) { .kpeOUc { padding: 60px 30px 0px; } }\n/* SelfServeLiveDemo__Tabs */ .ibsBVW { display: flex; gap: 16px; margin-bottom: 20px; }\n/* SelfServeLiveDemo__Tabs */ @media (max-width: 600px) { .ibsBVW { display: none; } }\n/* SelfServeLiveDemo__Tab */ .diqAPT { background: transparent; border: 1px solid var(--grid700, #6a565b); color: var(--fontColorLOUD, #ffffff); cursor: pointer; padding: 8px 14px; font-size: 14px; font-family: inherit; transition: color 120ms, bord