".CompareVs-module__JZ6Hwq__wrapper { background-image: var(--texture-hatch-img); border: 1px dashed var(--borderColorSTRONG); flex-direction: column; flex: 1 1 auto; align-items: center; gap: 24px; height: 100%; padding: 32px; display: flex; }\n.CompareVs-module__JZ6Hwq__logoRow { align-items: center; gap: 10px; display: flex; }\n.CompareVs-module__JZ6Hwq__hexLogo { width: auto; height: 20px; }\n.CompareVs-module__JZ6Hwq__versus { color: var(--fontColorLOUD); align-items: flex-end; height: 20px; padding-bottom: 2px; font-family: \"PP Editorial New\", sans-serif; font-size: 31px; font-style: italic; font-weight: 200; line-height: 20px; display: flex; }\n.CompareVs-module__JZ6Hwq__grid { flex-direction: column; flex: 1 1 auto; gap: 16px; width: 100%; display: flex; }\n.CompareVs-module__JZ6Hwq__horizontal { width: 100%; height: auto; }\n.CompareVs-module__JZ6Hwq__horizontal .CompareVs-module__JZ6Hwq__grid { grid-template-columns: repeat(4, minmax(0px, 1fr)); display: grid; }\n.CompareVs-module__JZ6Hwq__cardLink { color: inherit; background-color: rgba(0, 0, 0, 0); border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; flex: 1 1 auto; width: 100%; text-decoration: none; display: block; }\n.CompareVs-module__JZ6Hwq__cardLink:hover, .CompareVs-module__JZ6Hwq__cardLink:active { background-color: rgba(0, 0, 0, 0); }\n.CompareVs-module__JZ6Hwq__card.CompareVs-module__JZ6Hwq__card { flex: 1 1 auto; justify-content: center; align-items: center; width: 100%; padding: 30px; }\n.CompareVs-module__JZ6Hwq__arrow { position: absolute; top: 10px; right: 10px; }\n@media (max-width: 1250px) { .CompareVs-module__JZ6Hwq__wrapper { width: 100%; height: auto; } }\n@media (max-width: 1250px) { .CompareVs-module__JZ6Hwq__grid { flex-direction: row; } }\n@media (max-width: 1000px) { .CompareVs-module__JZ6Hwq__horizontal .CompareVs-module__JZ6Hwq__grid { grid-template-columns: repeat(2, minmax(0px, 1fr)); } }\n@media (max-width: 800px) { .CompareVs-module_